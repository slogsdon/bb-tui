{
  "name": "bb-tui",
  "version": "0.2.0",
  "description": "A terminal UI for bb — browse threads, follow streaming agent output, and reply.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slogsdon/bb-tui.git",
    "directory": "client"
  },
  "keywords": [
    "bb",
    "tui",
    "terminal",
    "ink",
    "agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bb-tui": "./dist/index.js",
    "bb-tui-cli": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.tsx",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "tsx --test src/*.test.*",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
